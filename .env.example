# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# ── API keys ────────────────────────────────────────────────────────────────

# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI key (TTS / chat) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Epidemic Sound partner API key (music licensing).
# Tracks pulled with this key are licensed to your account only —
# do not redistribute downloaded audio.
EPIDEMIC_SOUND_API_KEY=

# Stock footage APIs. Both are free to register for, and both tiers of
# material_fetcher / MediaSourcer silently no-op without a key.
# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay — https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ── Narration voice ─────────────────────────────────────────────────────────
# Engines are tried in order: ElevenLabs -> OpenAI -> Edge TTS. Edge is free
# and needs no key, but is the most obviously synthetic of the three.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=Dslrhjl3ZpzrctukrQSN
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# OpenAI TTS. gpt-4o-mini-tts accepts natural-language delivery direction and
# runs about $0.015/minute. Voices: alloy, ash, ballad, coral, echo, fable,
# nova, onyx, sage, shimmer, verse, marin, cedar.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx

# ── Services ────────────────────────────────────────────────────────────────

# Local Voicebox TTS server endpoint.
VOICEBOX_URL=http://127.0.0.1:17493

# ── YouTube b-roll ──────────────────────────────────────────────────────────
# Supplementary b-roll cut from YouTube when the stock libraries come up short.
# Needs yt-dlp installed; the tier disables itself cleanly if it is missing.

# Which licences the pipeline will pull from.
#   cc  (default) — Creative Commons only, i.e. cleared for reuse with credit.
#   any           — every result. Standard-licence uploads are NOT cleared for
#                   reuse; clearing rights on what you publish is on you.
# YOUTUBE_BROLL_LICENSE=cc

# Where the YouTube tier sits in the media order.
#   fallback (default) — after Pexels/Pixabay
#   first              — ahead of the stock APIs
#   off                — disabled
# YOUTUBE_BROLL_PRIORITY=fallback

# Credits for cached clips are written to <cache>/ATTRIBUTION.md — CC-BY
# footage must carry that credit wherever the finished video is published.
# YOUTUBE_BROLL_CACHE_DIR=./assets/materials/youtube

# Candidate filtering and cutting.
# YOUTUBE_BROLL_MIN_HEIGHT=720          # reject sources below this resolution
# YOUTUBE_BROLL_MAX_HEIGHT=1440         # cap the stream pulled; 4K costs minutes
# YOUTUBE_BROLL_MAX_SOURCE_SECONDS=1800 # skip anything longer than this
# YOUTUBE_BROLL_SEARCH_LIMIT=20         # search results to consider
# YOUTUBE_BROLL_DETAIL_CHECKS=6         # of those, how many to inspect fully
# YOUTUBE_BROLL_PROBE_FACTOR=5          # download this multiple of the clip length
# YOUTUBE_BROLL_MAX_PROBE_SECONDS=90    # hard cap on that download window
# YOUTUBE_BROLL_SCENE_THRESHOLD=0.30    # FFmpeg scene score that counts as a cut
# YOUTUBE_BROLL_RESOLUTION=1080x1920    # output frame size
# YOUTUBE_BROLL_FPS=30

# ── Paths ───────────────────────────────────────────────────────────────────
# Root folder holding your source footage. The category folders below default
# to subfolders of this, so usually you only need to set MEDIA_ROOT.
MEDIA_ROOT=./media

# Optional per-category overrides (default: <MEDIA_ROOT>/<Name>)
# LIFE_VIDEOS_DIR=
# NATURE_VIDEOS_DIR=
# GAMING_VIDEOS_DIR=
# MILITARY_VIDEOS_DIR=

# Where downloaded music is cached and rendered video is written.
# EPIDEMIC_MUSIC_DIR=./assets/epidemic_sound
# OUTPUT_DIR=./output

# AW360 director working directories. All default to folders inside the clone,
# so a fresh checkout runs without setting any of these. AW360 renders into
# <OUTPUT_DIR>/aw360 unless AW360_OUTPUT_DIR overrides it outright.
# ASSETS_DIR=./assets
# AW360_CACHE_DIR=./assets/aw360_cache
# AW360_FONT_DIR=./assets/fonts
# AW360_OUTPUT_DIR=
