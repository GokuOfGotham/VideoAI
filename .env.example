# Copy this file to .env and fill in your own keys.
# .env is gitignored and must never be committed.

# Google AI Studio key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI key (TTS / chat) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Epidemic Sound partner API key (music licensing).
# Tracks pulled with this key are licensed to your account only —
# do not redistribute downloaded audio.
EPIDEMIC_SOUND_API_KEY=

# Local Voicebox TTS server endpoint.
VOICEBOX_URL=http://127.0.0.1:17493
